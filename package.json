{
  "name": "djpm-2027",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run build:css && vite",
    "build": "npm run build:css && vite build",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./public/css/tailwind.css --minify && node scripts/kompat-css.js",
    "watch:css": "tailwindcss -i ./tailwind.input.css -o ./public/css/tailwind.css --watch",
    "preview": "vite preview",
    "check-lines": "node scripts/verify-lines.js",
    "check-css": "node scripts/cek-css-terbaru.js",
    "uji:cover": "node --test scripts/uji/cover-kelurahan.test.mjs",
    "uji:wajib-daftar-ri": "node --test scripts/uji/server-wajib-daftar-rumah-ibadah.test.mjs",
    "uji:validasi-penerima": "node --test scripts/uji/validasi-penerima.test.mjs scripts/uji/wilayah-tugas-utama.test.mjs scripts/uji/validasi-tanggal-lahir-layar.test.mjs scripts/uji/server-penerima.test.mjs scripts/uji/server-simpan-penerima.test.mjs scripts/uji/kabel-validasi-penerima.test.mjs",
    "check-koordinat": "node scripts/sinkron-koordinat.js --cek",
    "sync:2026": "node scripts/sync-2026.js",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "googleapis": "^178.0.0",
    "pg": "^8.23.0",
    "pptxgenjs": "^4.0.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "wrangler": "4.152.0"
  }
}
