# Header keamanan untuk Cloudflare Workers (Static Assets).
# Vite menyalin isi folder public/ ke root dist/ apa adanya, dan Cloudflare Workers (Static Assets) membaca file
# _headers ini otomatis dari root hasil build. Format: https://developers.cloudflare.com/pages/configuration/headers/
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), clipboard-read=(), clipboard-write=(self)

# Halaman publik Cek Status: tidak boleh di-cache bersama; CSP ketat (skrip sendiri + Turnstile saja, sambung hanya ke asal sendiri).
/cek-status*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src https://challenges.cloudflare.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/logo-medan.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
